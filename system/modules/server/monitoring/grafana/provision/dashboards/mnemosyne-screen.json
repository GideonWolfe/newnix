                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": [
              {
                "group": "filterFieldsByName",
                "kind": "Transformation",
                "spec": {
                  "options": {
                    "include": {
                      "names": [
                        "Time",
                        "{device=\"/dev/nvme0n1p3\", fstype=\"ext4\", instance=\"mnemosyne:9100\", job=\"node\", mountpoint=\"/\"}"
                      ]
                    }
                  }
                }
              }
            ]
