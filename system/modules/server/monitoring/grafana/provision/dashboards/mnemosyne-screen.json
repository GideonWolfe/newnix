                    },
                    "group": "prometheus",
                    "kind": "DataQuery",
                    "spec": {
                      "editorMode": "builder",
                      "expr": "zfs_pool_health{pool=\"tank\", instance=\"mnemosyne:9100\"}",
                      "instant": false,
                      "interval": "5m",
                      "legendFormat": "__auto",
                      "range": true
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": [
              {
                "group": "renameByRegex",
                "kind": "Transformation",
                "spec": {
                  "options": {
                    "regex": ".*pool=\"([^\"]+)\".*",
                    "renamePattern": "$1"
                  }
                }
              }
            ]
          }
        },
        "description": "",
        "id": 2,
        "links": [],
        "title": "Pool Status",
        "transparent": true,
        "vizConfig": {
          "group": "stat",
          "kind": "VizConfig",
