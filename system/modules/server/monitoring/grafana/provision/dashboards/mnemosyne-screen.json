            "fieldConfig": {
              "defaults": {
                "color": {
                  "mode": "thresholds"
                },
                "mappings": [
                  {
                    "options": {
                      "0": {
                        "color": "green",
                        "index": 0,
                        "text": "ONLINE"
                      },
                      "1": {
                        "color": "orange",
                        "index": 1,
                        "text": "DEGRADED"
                      },
                      "2": {
                        "color": "super-light-orange",
                        "index": 2,
                        "text": "FAULTED"
                      },
                      "3": {
                        "color": "red",
                        "index": 3,
                        "text": "OFFLINE"
                      },
                      "4": {
                        "color": "dark-yellow",
                        "index": 4,
                        "text": "UNAVAILABLE"
                      },
                      "5": {
                        "color": "dark-yellow",
                        "index": 5,
                        "text": "REMOVED"
                      },
                      "6": {
                        "color": "dark-yellow",
                        "index": 6,
                        "text": "SUSPENDED"
                      }
                    },
                    "type": "value"
                  }
                ],
                "noValue": "OFFLINE",
                "thresholds": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": 0
                    }
                  ]
                }
              },
              "overrides": []
            },
            "options": {
              "colorMode": "value",
              "graphMode": "none",
              "justifyMode": "auto",
              "orientation": "auto",
              "percentChangeColorMode": "standard",
              "reduceOptions": {
                "calcs": [
                  "lastNotNull"
